# Database
# Example MySQL connection string. Replace with your local or hosted MySQL credentials.
DATABASE_URL="mysql://user:password@localhost:3306/personal_website_dev"

# Authentication
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-key-here-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Email Service (Resend)
# Get your API key from https://resend.com
RESEND_API_KEY="re_your_api_key_here"

# Site Configuration
NEXT_PUBLIC_SITE_NAME="My Portfolio"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin Email (where to send contact form messages)
ADMIN_EMAIL="your-email@example.com"

# Analytics (Optional)
# NEXT_PUBLIC_ANALYTICS_ID="your-analytics-id"

# Node Environment
NODE_ENV="development"
