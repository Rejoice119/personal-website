// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Admin user account
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hashed
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// Portfolio projects
model Project {
  id           String   @id @default(cuid())
  title        String
  description  String   @db.Text
  shortDesc    String   // Short description for cards
  technologies String[] // Array of tech used
  imageUrl     String
  imageAlt     String
  projectUrl   String? // Link to live project
  githubUrl    String?
  caseStudy    String?  @db.Text // Detailed case study
  featured     Boolean  @default(false)
  order        Int      @default(0) // For custom ordering
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([featured])
  @@index([order])
}

// Skills/Expertise
model Skill {
  id        String   @id @default(cuid())
  name      String
  level     String   // "Beginner", "Intermediate", "Advanced", "Expert"
  category  String   // "Frontend", "Backend", "DevOps", "Database", etc.
  icon      String? // Icon name or URL
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([order])
}

// Contact form messages
model Message {
  id        String   @id @default(cuid())
  email     String
  name      String
  subject   String
  message   String   @db.Text
  status    String   @default("unread") // "unread", "read", "replied"
  reply     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Visitor testimonials (submitted by visitors, approved by admin)
model Testimonial {
  id        String   @id @default(cuid())
  author    String
  email     String
  company   String?
  position  String? // Job title
  content   String   @db.Text
  rating    Int?     // 1-5 star rating
  imageUrl  String? // Profile photo
  websiteUrl String? // Portfolio/company link
  approved  Boolean  @default(false)
  featured  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approved])
  @@index([featured])
  @@index([createdAt])
}

// Site settings/configuration
model SiteSettings {
  id              String   @id @default(cuid())
  siteName        String   @default("Personal Portfolio")
  siteDescription String   @db.Text
  bio             String   @db.Text
  email           String
  phone           String?
  location        String?
  
  // Social links
  socialTwitter   String?
  socialLinkedIn  String?
  socialGithub    String?
  socialInstagram String?
  socialFacebook  String?
  
  // Resume/CV
  resumeUrl       String?
  
  // Theme
  primaryColor    String   @default("#3B82F6")
  secondaryColor  String   @default("#1F2937")
  
  updatedAt       DateTime @updatedAt

  @@id // Only one record should exist
}

// Site visitor analytics (basic tracking)
model PageView {
  id        String   @id @default(cuid())
  page      String   // "/", "/projects", etc.
  referrer  String?
  userAgent String?
  ipHash    String?  // Hash of IP for privacy
  createdAt DateTime @default(now())

  @@index([page])
  @@index([createdAt])
}
